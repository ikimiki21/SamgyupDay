<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController" prefWidth="400.0" prefHeight="460.0">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <Label text="SamgyupDay POS Login" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <!-- Control 1: Username Field -->
    <Label text="Username / Staff ID:" />
    <TextField fx:id="usernameField" promptText="e.g., EMP-101" />
    
    <!-- Control 2: Password Field -->
    <Label text="Password:" />
    <PasswordField fx:id="passwordField" promptText="Enter your password" />
    
    <!-- Control 3: Dropdown Role -->
    <Label text="System Role:" />
    <ComboBox fx:id="roleComboBox" promptText="Select system role" prefWidth="360.0" />
    
    <!-- Control 4: Checkbox -->
    <CheckBox fx:id="rememberMeCheckBox" text="Remember Terminal ID on this station" />
    
    <!-- Control 5: Hyperlink -->
    <Hyperlink fx:id="forgotPasswordLink" text="Forgot Credentials?" onAction="#handleForgotPassword" />
    
    <!-- Control 6: Hidden Field Equivalent -->
    <TextField fx:id="terminalIdField" text="ST-MARY-TERM-01" disable="true" visible="false" />
    
    <!-- Control 7: Status/Error Label -->
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red; -fx-wrap-text: true;" />
    
    <!-- Control 8: Submit Button -->
    <Button fx:id="loginButton" text="Sign In to Terminal" onAction="#handleLogin" prefWidth="360.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white;" />
</VBox>
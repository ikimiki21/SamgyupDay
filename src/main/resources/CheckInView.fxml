<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CheckInController" prefWidth="480.0" prefHeight="580.0">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Defined first so its Label can reference it with labelFor; placed below with fx:reference. -->
    <fx:define>
        <TextArea fx:id="tableNotesArea" promptText="e.g., Extra high chair needed, table grill pre-heated" prefHeight="60.0" />
    </fx:define>

    <Label text="Customer Table Check-In &amp; Seating" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <!-- In the grid each input is declared before its Label so labelFor can reference it.
         Grid position is set by rowIndex/columnIndex; Tab follows the inputs' order (top to bottom). -->
    <GridPane hgap="10" vgap="12">
        <!-- Control 1: Table Selection -->
        <ComboBox fx:id="tableCombo" promptText="Choose Table" prefWidth="200.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <Label text="Select Table Number:" labelFor="$tableCombo" GridPane.rowIndex="0" GridPane.columnIndex="0" />

        <!-- Control 2: Total Headcount -->
        <TextField fx:id="headcountField" promptText="e.g., 4" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        <Label text="Total Guest Headcount:" labelFor="$headcountField" GridPane.rowIndex="1" GridPane.columnIndex="0" />

        <!-- Control 3: Dining Tier Selection -->
        <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <RadioButton fx:id="tier299" text="₱299 Basic Pork Tier" />
            <RadioButton fx:id="tier399" text="₱399 Standard Combo Tier" selected="true" />
            <RadioButton fx:id="tier499" text="₱499 Premium Unlimited Tier" />
        </VBox>
        <Label text="Package Tier:" labelFor="$tier299" GridPane.rowIndex="2" GridPane.columnIndex="0" />

        <!-- Control 4: Checkbox Child Rate -->
        <CheckBox fx:id="childCheckBox" text="Include Child Discount Rate" onAction="#handleChildToggle" GridPane.rowIndex="3" GridPane.columnIndex="1" />
        <Label text="Special Headcount:" labelFor="$childCheckBox" GridPane.rowIndex="3" GridPane.columnIndex="0" />

        <!-- Control 5: Child Headcount Input -->
        <TextField fx:id="childHeadcountField" promptText="0" disable="true" GridPane.rowIndex="4" GridPane.columnIndex="1" />
        <Label text="Child Headcount:" labelFor="$childHeadcountField" GridPane.rowIndex="4" GridPane.columnIndex="0" />

        <!-- Control 6: Toggle Switch 2-Hr Timer -->
        <ToggleButton fx:id="timerToggle" text="Start 2-Hour Timer Automatically" selected="true" GridPane.rowIndex="5" GridPane.columnIndex="1" />
        <Label text="2-Hour Timer Control:" labelFor="$timerToggle" GridPane.rowIndex="5" GridPane.columnIndex="0" />

        <!-- Control 7: Server ID -->
        <TextField fx:id="cashierIdField" text="CSH-004" disable="true" GridPane.rowIndex="6" GridPane.columnIndex="1" />
        <Label text="Assigned Cashier ID:" labelFor="$cashierIdField" GridPane.rowIndex="6" GridPane.columnIndex="0" />
    </GridPane>

    <!-- Control 8: Text Area Special Requests -->
    <Label text="Special Table Requests / Notes:" labelFor="$tableNotesArea" />
    <fx:reference source="tableNotesArea" />

    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;" />

    <!-- Control 9: Submit Button -->
    <Button text="Confirm Table Check-In" onAction="#handleCheckIn" prefWidth="440.0" style="-fx-background-color: #2980b9; -fx-text-fill: white;" />
</VBox>
